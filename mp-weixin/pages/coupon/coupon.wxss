.container {
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 20rpx 0 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

/* 优惠券卡片 */
.coupon-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.coupon-card.grabbed {
  opacity: 0.6;
}

.coupon-left {
  width: 200rpx;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #ff6b35, #ee3b3b);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.discount-value {
  font-size: 48rpx;
  font-weight: bold;
}

.threshold {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.coupon-right {
  flex: 1;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

.coupon-stock {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
}

.coupon-btn {
  padding: 0 24rpx;
}

.grab-btn {
  background: #E95F3C;
  color: #fff;
  font-size: 26rpx;
  border: none;
  border-radius: 30rpx;
  padding: 12rpx 30rpx;
  line-height: 1.5;
}

.grabbed-tag {
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 20rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 我的优惠券 */
.section-title {
  padding: 30rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.my-coupon-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.my-coupon-card.used {
  opacity: 0.5;
}

.my-coupon-info {
  display: flex;
  flex-direction: column;
}

.my-coupon-id {
  font-size: 28rpx;
  color: #333;
}

.my-coupon-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.status-unused {
  color: #E95F3C;
  font-size: 26rpx;
  font-weight: bold;
}

.status-used {
  color: #999;
  font-size: 26rpx;
}
